---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import OperatingModel from "../components/OperatingModel.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Methods from "../components/Methods.astro";
import Documents from "../components/Documents.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { cases, methods, operatingSteps } from "../data/portfolio";
import { downloads } from "../data/assets";
import { externalLinks } from "../data/site";

const title = "ChrisBuen | AI Automation Builder";
const description = "Client-facing stories of evidence-led automation systems for due diligence, document production, research, publishing, and recurring market intelligence.";
const [flagship, ...supportingCases] = cases;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content">
    <Hero />

    <section class="systems-intro section-shell" id="systems" aria-labelledby="systems-title">
      <div class="systems-intro__heading reveal-copy">
        <p class="section-label">Selected systems / one evidence-led practice</p>
        <h2 id="systems-title">Five client problems. Five different operating systems.</h2>
        <p>Start with the flagship case, then compare how the same discipline changes across documents, research, publishing, and recurring intelligence.</p>
      </div>
      <nav class="case-navigator" aria-label="Portfolio cases" data-case-navigator>
        <ol>
          {cases.map((item) => (
            <li>
              <a href={`#${item.slug}`} data-case-link={item.slug}>
                <span>{item.index}</span>
                <strong>{item.shortTitle}</strong>
                <small>{item.clientValue}</small>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>

    <div class="case-collection case-collection--flagship">
      <CaseStudy caseStudy={flagship} />
    </div>

    <OperatingModel steps={operatingSteps} />

    <section class="supporting-intro section-shell" aria-labelledby="supporting-title">
      <p class="section-label">The practice expands</p>
      <div class="supporting-intro__grid reveal-copy">
        <h2 id="supporting-title">The topology changes because the problem changes.</h2>
        <p>A document pipeline needs source hierarchy. Research needs a linear evidence chain. Publishing needs state reconciliation. Recurring reports need two lanes that never collapse into one.</p>
      </div>
    </section>

    <div class="case-collection">
      {supportingCases.map((caseStudy) => <CaseStudy {caseStudy} />)}
    </div>

    <Methods {methods} />

    <section class="philosophy section-shell" id="philosophy" aria-labelledby="philosophy-title">
      <p class="section-label">How I work with a client</p>
      <div class="philosophy-grid reveal-copy">
        <h2 id="philosophy-title">I make the messy parts explicit before I automate them.</h2>
        <div>
          <p>I begin by finding the source of truth, the uncertainty, and the person who owns the consequential decision. Then I define what the system is allowed to move, what must stop, and what evidence has to survive the handoff.</p>
          <p>That produces automations that are easier to review, repair, and extend. The goal is not to remove people from difficult work. It is to give them a better operating system for doing it.</p>
        </div>
      </div>
      <ol class="working-sequence" aria-label="Client delivery sequence">
        <li><span>01</span><strong>Discover the real decision</strong><p>Map sources, owners, edge cases, and the cost of a wrong handoff.</p></li>
        <li><span>02</span><strong>Design the control model</strong><p>Define stages, artifacts, failure routes, and the human boundary before choosing tools.</p></li>
        <li><span>03</span><strong>Build and prove</strong><p>Implement the smallest reliable path, validate its outputs, and keep limitations visible.</p></li>
        <li><span>04</span><strong>Hand over an inspectable system</strong><p>Leave the client with operating guidance, evidence, and a route for future change.</p></li>
      </ol>
    </section>

    <Documents />

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div class="section-shell final-cta__inner">
        <p class="section-label">The next useful step</p>
        <h2 id="final-cta-title">Bring me the process that keeps breaking between people, tools, and decisions.</h2>
        <p>I will start by finding the evidence boundary and the handoff that needs to become reliable.</p>
        <div class="hero-actions">
          {externalLinks.booking ? (
            <a class="button button-primary" href={externalLinks.booking}>Discuss the workflow <span aria-hidden="true">↗</span></a>
          ) : (
            <a class="button button-primary" href={downloads[1].href} download={downloads[1].filename}>Take the complete casebook <span aria-hidden="true">↓</span></a>
          )}
          <a class="button button-secondary" href="#onboarding">Replay the flagship case <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add("js");

    const motion = gsap.matchMedia();
    const cleanups: Array<() => void> = [];

    const revealHashTarget = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      const disclosure = target instanceof HTMLDetailsElement ? target : target.closest("details");
      if (disclosure instanceof HTMLDetailsElement) disclosure.open = true;
    };

    revealHashTarget();
    window.addEventListener("hashchange", revealHashTarget);
    cleanups.push(() => window.removeEventListener("hashchange", revealHashTarget));

    const caseObserver = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      document.querySelectorAll<HTMLElement>("[data-case-link]").forEach((link) => {
        const active = link.dataset.caseLink === visible.target.id;
        link.toggleAttribute("data-active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }, { rootMargin: "-30% 0px -58%", threshold: [0.01, 0.25, 0.5] });
    document.querySelectorAll<HTMLElement>("[data-case-study]").forEach((caseStudy) => caseObserver.observe(caseStudy));
    cleanups.push(() => caseObserver.disconnect());

    motion.add("(min-width: 821px) and (prefers-reduced-motion: no-preference)", () => {
      const intro = gsap.timeline({ defaults: { ease: "power4.out" } });
      intro
        .from("[data-site-header]", { y: -18, duration: 0.45 })
        .from("[data-hero-copy] > *", { y: 26, duration: 0.7, stagger: 0.08 }, "-=0.12")
        .from("[data-hero-stage]", { y: 34, duration: 0.85 }, "-=0.55")
        .from("[data-hero-fragment]", { x: -18, duration: 0.42, stagger: 0.07 }, "-=0.42")
        .from("[data-hero-casefile]", { y: 18, duration: 0.5 }, "-=0.26")
        .from("[data-hero-lane]", { x: -10, duration: 0.28, stagger: 0.06 }, "-=0.2")
        .from("[data-hero-gate], [data-hero-decision]", { x: 16, duration: 0.4, stagger: 0.1 }, "-=0.15");

      gsap.utils.toArray<HTMLElement>(".reveal-copy").forEach((element) => {
        gsap.from(element.children, {
          y: 24,
          duration: 0.72,
          stagger: 0.08,
          ease: "power4.out",
          scrollTrigger: { trigger: element, start: "top 84%", once: true },
        });
      });

      gsap.utils.toArray<HTMLElement>("[data-story-beat]").forEach((beat) => {
        gsap.from(beat, {
          y: 18,
          duration: 0.65,
          ease: "power3.out",
          scrollTrigger: { trigger: beat, start: "top 88%", once: true },
        });
      });

      gsap.utils.toArray<HTMLElement>("[data-workflow-atlas]").forEach((atlas) => {
        const parts = atlas.querySelectorAll(":scope > .atlas-header, :scope > .atlas-journey, :scope > .atlas-legend, :scope > .diagram-viewer");
        gsap.from(parts, {
          y: 20,
          duration: 0.72,
          stagger: 0.08,
          ease: "power3.out",
          scrollTrigger: { trigger: atlas, start: "top 84%", once: true },
        });
      });

      document.fonts.ready.then(() => ScrollTrigger.refresh());
      return () => ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    });

    motion.add("(max-width: 820px), (prefers-reduced-motion: reduce)", () => {
      gsap.set("[data-story-beat], [data-workflow-atlas]", { clearProps: "opacity,transform" });
    });

    window.addEventListener("pagehide", () => {
      cleanups.forEach((cleanup) => cleanup());
      motion.revert();
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    }, { once: true });
  </script>
</BaseLayout>
