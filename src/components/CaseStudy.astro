---
import { caseDecisionDiagrams, caseDiagrams } from "../data/assets";
import { externalLinks } from "../data/site";
import WorkflowAtlas from "./WorkflowAtlas.astro";
import type { ProjectCase } from "../data/portfolio";

interface Props { caseStudy: ProjectCase }
const { caseStudy } = Astro.props;
const systemDiagram = caseDiagrams[caseStudy.slug];
const decisionDiagram = caseDecisionDiagrams[caseStudy.slug];
const sourceHref = (sourcePath: string) => {
  if (!externalLinks.github) return undefined;
  return `${externalLinks.github}/blob/main/${sourcePath.split("/").map(encodeURIComponent).join("/")}`;
};
const diagramHref = (sourcePath: string) => {
  if (sourcePath === systemDiagram?.sourcePath) return systemDiagram.large;
  if (sourcePath === decisionDiagram?.sourcePath) return decisionDiagram.large;
  return undefined;
};
const evidence = [
  ...caseStudy.evidence,
  ...(decisionDiagram ? [{
    label: "Quality decision tree",
    path: decisionDiagram.sourcePath,
    description: "Separates the pass path from every hold, return, correction owner, and human-control boundary.",
  }] : []),
];
const openingBeats = caseStudy.beats.slice(0, 3);
const solutionBeats = caseStudy.beats.slice(3);
---

<article
  id={caseStudy.slug}
  class:list={["case-study", { "case-study--flagship": caseStudy.slug === "onboarding" }]}
  data-case-study
  data-case-id={caseStudy.slug}
  aria-labelledby={`${caseStudy.slug}-title`}
>
  <header class="case-intro section-shell">
    <div class="case-index" aria-hidden="true">{caseStudy.index}</div>
    <div class="case-intro__copy">
      <p class="section-label">{caseStudy.eyebrow}</p>
      <h2 id={`${caseStudy.slug}-title`}>{caseStudy.title}</h2>
      <p class="case-lede">{caseStudy.lede}</p>
    </div>
    <aside class="case-status" aria-label="Implementation status">
      <span>Status at source cut-off</span>
      <strong>{caseStudy.status}</strong>
      <p>{caseStudy.statusDetail}</p>
    </aside>
  </header>

  <section class="case-origin section-shell" aria-labelledby={`${caseStudy.slug}-origin-title`}>
    <header class="case-origin__header">
      <p class="section-label">Why this system exists</p>
      <h3 id={`${caseStudy.slug}-origin-title`}>The workflow begins with the failure it has to prevent.</h3>
      <p>{caseStudy.scenePrompt}</p>
    </header>
    <div class="case-origin__story">
      {openingBeats.map((beat) => (
        <section class="origin-beat" data-story-beat data-step={beat.step} aria-labelledby={`${caseStudy.slug}-${beat.id}`}>
          <span>{String(beat.step).padStart(2, "0")}</span>
          <div>
            <p class="story-beat__label">{beat.label}</p>
            <h4 id={`${caseStudy.slug}-${beat.id}`}>{beat.title}</h4>
            <p>{beat.body}</p>
          </div>
        </section>
      ))}
    </div>
  </section>

  <WorkflowAtlas {caseStudy} />

  <section class="case-solution section-shell" aria-labelledby={`${caseStudy.slug}-solution-title`}>
    <header class="case-solution__header">
      <p class="section-label">From mechanism to client value</p>
      <h3 id={`${caseStudy.slug}-solution-title`}>The schematic shows the route. These are the choices that make it useful.</h3>
    </header>
    <div class="case-solution__grid">
      {solutionBeats.map((beat) => (
        <section class="solution-beat" data-story-beat data-step={beat.step} aria-labelledby={`${caseStudy.slug}-${beat.id}`}>
          <span>{String(beat.step).padStart(2, "0")}</span>
          <p class="story-beat__label">{beat.label}</p>
          <h4 id={`${caseStudy.slug}-${beat.id}`}>{beat.title}</h4>
          <p>{beat.body}</p>
        </section>
      ))}
    </div>
  </section>

  <section class="case-resolution section-shell" aria-labelledby={`${caseStudy.slug}-result-title`}>
    <div class="case-resolution__value">
      <p class="section-label">What changes for the client</p>
      <h3 id={`${caseStudy.slug}-result-title`}>{caseStudy.clientValue}</h3>
    </div>
    <div class="case-boundaries">
      <div>
        <p class="boundary-label boundary-label--human">Where a person decides</p>
        <p>{caseStudy.humanDecision}</p>
      </div>
      <div>
        <p class="boundary-label">What the public portfolio excludes</p>
        <p>{caseStudy.publicBoundary}</p>
      </div>
    </div>
  </section>

  <details class="case-proof section-shell" id={`${caseStudy.slug}-proof`}>
    <summary>
      <span>Inspect the proof behind this case</span>
      <span aria-hidden="true">+</span>
    </summary>
    <div class="case-proof__body">
      <div class="case-proof__intro">
        <p class="section-label">Evidence, not decoration</p>
        <h3>{caseStudy.artifactLabel}</h3>
        <p>{caseStudy.proofNote}</p>
      </div>
      <ul class="evidence-ledger">
        {evidence.map((item, index) => (
          <li>
            <span class="evidence-number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{item.label}</strong>
              <p>{item.description}</p>
              <code>{item.path}</code>
            </div>
            {sourceHref(item.path) ? (
              <a href={sourceHref(item.path)} aria-label={`Inspect ${item.label} in the public repository`}>Inspect <span aria-hidden="true">↗</span></a>
            ) : diagramHref(item.path) ? (
              <a href={diagramHref(item.path)} aria-label={`Open ${item.label}`}>Open chart <span aria-hidden="true">↗</span></a>
            ) : (
              <span class="evidence-source-state">Path recorded</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </details>
</article>

<style>
  .case-study {
    border-top: 1px solid var(--color-line);
    padding: clamp(6rem, 12vw, 11rem) 0 clamp(5rem, 10vw, 9rem);
    scroll-margin-top: 5rem;
  }

  .case-study--flagship { padding-top: clamp(4.5rem, 9vw, 8rem); }

  .case-intro {
    display: grid;
    grid-template-columns: clamp(4rem, 9vw, 8rem) minmax(0, 1fr) minmax(16rem, 24rem);
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: start;
  }

  .case-index {
    color: var(--color-line-bright);
    font-size: clamp(3.5rem, 8vw, 8rem);
    font-weight: 520;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .case-intro h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.7rem, 6.4vw, 6.7rem);
    font-weight: 540;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .case-lede {
    max-width: 61ch;
    margin: 1.65rem 0 0;
    color: var(--color-text-soft);
    font-size: var(--type-lede);
    line-height: 1.58;
  }

  .case-status { padding-top: 0.9rem; border-top: 1px solid var(--color-line-bright); }

  .case-status > span,
  .story-beat__label,
  .boundary-label {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 520;
    letter-spacing: 0.055em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .case-status strong { display: block; margin-top: 0.75rem; color: var(--color-text); font-size: 1rem; font-weight: 540; line-height: 1.45; }
  .case-status p { margin: 0.75rem 0 0; color: var(--color-muted); font-size: 0.88rem; line-height: 1.55; }

  .case-origin {
    display: grid;
    margin-top: clamp(4rem, 8vw, 8rem);
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: start;
  }

  .case-origin__header { position: sticky; top: 6.5rem; }
  .case-origin__header h3,
  .case-solution__header h3 { max-width: 18ch; margin: 0; font-size: clamp(2rem, 4vw, 4.5rem); font-weight: 520; letter-spacing: -0.045em; line-height: 1; }
  .case-origin__header > p:last-child { max-width: 52ch; margin: 1.35rem 0 0; color: var(--color-muted); font-size: 0.94rem; line-height: 1.65; }

  .case-origin__story { border-top: 1px solid var(--color-line-bright); }
  .origin-beat { display: grid; padding: clamp(2rem, 4vw, 4rem) 0; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .origin-beat > span,
  .solution-beat > span { color: var(--color-signal); font-family: var(--font-mono); font-size: 0.78rem; }
  .origin-beat h4,
  .solution-beat h4 { max-width: 24ch; margin: 0.55rem 0 0.9rem; font-size: clamp(1.4rem, 2.4vw, 2.45rem); font-weight: 540; letter-spacing: -0.03em; line-height: 1.08; }
  .origin-beat p:last-child,
  .solution-beat p:last-child { max-width: 62ch; margin: 0; color: var(--color-text-soft); font-size: 1rem; line-height: 1.72; }

  .case-solution { margin-top: clamp(4rem, 9vw, 9rem); }
  .case-solution__header { display: grid; margin-bottom: clamp(3rem, 6vw, 6rem); grid-template-columns: 0.55fr 1fr; gap: clamp(2rem, 7vw, 8rem); align-items: end; }
  .case-solution__header .section-label { align-self: start; }
  .case-solution__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 6vw, 7rem); }
  .solution-beat { display: grid; padding: clamp(2rem, 4vw, 3.75rem) 0; grid-template-columns: 2.5rem minmax(0, 1fr); border-top: 1px solid var(--color-line-bright); }
  .solution-beat .story-beat__label,
  .solution-beat h4,
  .solution-beat p:last-child { grid-column: 2; }

  .case-resolution {
    display: grid;
    margin-top: clamp(3rem, 7vw, 7rem);
    padding-top: clamp(3rem, 7vw, 7rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--color-line);
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
    gap: clamp(3rem, 8vw, 9rem);
  }

  .case-resolution__value h3 { max-width: 22ch; margin: 0; font-size: clamp(2rem, 4.2vw, 4.6rem); font-weight: 520; letter-spacing: -0.045em; line-height: 1; }
  .case-boundaries { display: grid; gap: 2rem; }
  .case-boundaries > div { padding-top: 1rem; border-top: 1px solid var(--color-line-bright); }
  .boundary-label--human { color: var(--color-review); }
  .case-boundaries p:last-child { margin: 0.65rem 0 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.6; }

  .case-proof { border-top: 1px solid var(--color-line-bright); border-bottom: 1px solid var(--color-line); }
  .case-proof summary { display: flex; min-height: 4.75rem; align-items: center; justify-content: space-between; cursor: pointer; font-size: 1rem; font-weight: 540; list-style: none; touch-action: manipulation; }
  .case-proof summary::-webkit-details-marker { display: none; }
  .case-proof summary span:last-child { color: var(--color-signal); font-size: 1.45rem; transition: transform 180ms var(--ease-out); }
  .case-proof[open] summary span:last-child { transform: rotate(45deg); }
  .case-proof__body { display: grid; padding: 1rem 0 4rem; grid-template-columns: minmax(15rem, 0.42fr) minmax(0, 1.58fr); gap: clamp(2rem, 5vw, 6rem); }
  .case-proof__intro h3 { margin: 0; font-size: clamp(1.6rem, 2.7vw, 2.9rem); line-height: 1.05; }
  .case-proof__intro > p:last-child { margin: 1rem 0 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.6; }

  .evidence-ledger { margin: 0; padding: 0; border-top: 1px solid var(--color-line); list-style: none; }
  .evidence-ledger li { display: grid; padding: 1.25rem 0; grid-template-columns: 3rem minmax(0, 1fr) auto; gap: 1rem; align-items: start; border-bottom: 1px solid var(--color-line); }
  .evidence-number,
  .evidence-source-state,
  .evidence-ledger code,
  .evidence-ledger a { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--type-label); letter-spacing: 0.035em; }
  .evidence-ledger strong { display: block; font-size: 0.95rem; }
  .evidence-ledger p { max-width: 70ch; margin: 0.35rem 0 0.55rem; color: var(--color-muted); font-size: 0.84rem; line-height: 1.55; }
  .evidence-ledger code { overflow-wrap: anywhere; }
  .evidence-ledger a { display: inline-flex; min-height: 44px; align-items: center; color: var(--color-text); text-decoration: none; }
  .evidence-source-state { padding-top: 0.15rem; }

  @media (max-width: 1100px) {
    .case-intro { grid-template-columns: 4.5rem minmax(0, 1fr); }
    .case-status { grid-column: 2; max-width: 40rem; }
    .case-origin { grid-template-columns: minmax(16rem, 0.6fr) minmax(0, 1.4fr); gap: 3rem; }
  }

  @media (max-width: 820px) {
    .case-study { padding-block: 5.5rem; }
    .case-intro { grid-template-columns: 1fr; gap: 1.25rem; }
    .case-index { font-size: 3.5rem; }
    .case-status { grid-column: 1; margin-top: 1rem; }
    .case-origin { grid-template-columns: 1fr; margin-top: 3.5rem; }
    .case-origin__header { position: static; }
    .case-solution__header,
    .case-solution__grid,
    .case-resolution,
    .case-proof__body { grid-template-columns: 1fr; }
    .case-solution__header { gap: 1rem; }
    .solution-beat { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .evidence-ledger li { grid-template-columns: 2rem minmax(0, 1fr); }
    .evidence-ledger a,
    .evidence-source-state { grid-column: 2; justify-self: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-proof summary span:last-child { transition: none; }
  }
</style>
